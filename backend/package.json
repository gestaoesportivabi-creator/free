{
  "name": "scout-21-pro-backend",
  "version": "1.0.0",
  "description": "Backend PostgreSQL para SCOUT 21 PRO - Sistema de Gestão Esportiva",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/app.ts",
    "build": "prisma generate && tsc",
    "start": "node dist/app.js",
    "migrate": "tsx scripts/run-migrations.ts",
    "migrate:create": "tsx scripts/create-migration.ts",
    "migrate:apply": "tsx scripts/apply-migration.ts",
    "backfill:subscriptions": "tsx scripts/backfill-subscriptions.ts",
    "seed:admin": "tsx scripts/seed-admin.ts",
    "seed:demo": "tsx scripts/seed-demo-data.ts",
    "seed:chopinzinho": "tsx scripts/seed-chopinzinho-lnf.ts",
    "seed:qa-environment": "tsx scripts/seed-qa-environment.ts",
    "qa:reset-password": "tsx scripts/reset-qa-password.ts",
    "cleanup:qa-environment": "tsx scripts/cleanup-qa-environment.ts",
    "lint": "eslint src --ext .ts",
    "type-check": "tsc --noEmit",
    "postinstall": "prisma generate"
  },
  "keywords": [
    "sports",
    "scout",
    "postgresql",
    "express",
    "typescript"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "express": "^4.18.2",
    "cors": "^2.8.5",
    "helmet": "^7.1.0",
    "dotenv": "^16.3.1",
    "bcrypt": "^5.1.1",
    "jsonwebtoken": "^9.0.2",
    "zod": "^3.22.4",
    "@prisma/client": "^5.7.1",
    "pg": "^8.11.3",
    "resend": "^4.5.1"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^20.10.5",
    "@types/cors": "^2.8.17",
    "@types/bcrypt": "^5.0.2",
    "@types/jsonwebtoken": "^9.0.5",
    "@types/pg": "^8.10.9",
    "@typescript-eslint/eslint-plugin": "^6.15.0",
    "@typescript-eslint/parser": "^6.15.0",
    "eslint": "^8.56.0",
    "prisma": "^5.7.1",
    "tsx": "^4.7.0",
    "typescript": "^5.3.3"
  }
}

