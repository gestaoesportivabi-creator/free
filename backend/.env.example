# Database - Supabase (mesmo banco para local e produção)
#
# MCP (Cursor → Tools & MCP → Supabase) é só para o assistente no IDE (SQL, migrações, etc.).
# O servidor API (Prisma) SEMPRE usa DATABASE_URL / DIRECT_URL abaixo — MCP não substitui isso.
#
# Obtenha em: Supabase Dashboard → Settings → Database → Connection string
# LOCAL (dev): conexão direta 5432 evita "Tenant or user not found" no pooler.
# VERCEL (produção): DATABASE_URL = Transaction pooler 6543 (usuário postgres.[REF], host aws-1-...pooler).
# DIRECT_URL: conexão direta 5432 — migrations (`prisma db execute`, `prisma migrate`).
# Senha na URL: codifique caracteres especiais (# → %23, @ → %40, etc.).
#
# Exemplo projeto mymuvraqtnoqrtuzoimj (copie a senha do painel Supabase):
# DATABASE_URL (Vercel)= postgresql://postgres.mymuvraqtnoqrtuzoimj:[SENHA]@aws-1-us-east-1.pooler.supabase.com:6543/postgres?pgbouncer=true&sslmode=require
# DIRECT_URL / local  = postgresql://postgres:[SENHA]@db.mymuvraqtnoqrtuzoimj.supabase.co:5432/postgres?sslmode=require
#
# Se login em produção retornar 503: confira DATABASE_URL no Vercel (host aws-1, user postgres.[REF], senha atual).
DATABASE_URL=postgresql://postgres.mymuvraqtnoqrtuzoimj:[SENHA]@aws-1-us-east-1.pooler.supabase.com:6543/postgres?pgbouncer=true&sslmode=require
DIRECT_URL=postgresql://postgres:[SENHA]@db.mymuvraqtnoqrtuzoimj.supabase.co:5432/postgres?sslmode=require

# Server
PORT=3000
NODE_ENV=development

# JWT - OBRIGATÓRIO: usar o MESMO valor no Vercel para tokens funcionarem em ambos os ambientes
JWT_SECRET=sua-chave-secreta-forte
JWT_EXPIRES_IN=7d

# CORS (local)
CORS_ORIGIN=http://localhost:5173
FRONTEND_URL=http://localhost:5173
