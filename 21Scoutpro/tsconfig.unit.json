{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "types": ["node"],
    "typeRoots": ["../backend/node_modules/@types", "./node_modules/@types"],
    "esModuleInterop": true,
    "isolatedModules": true
  },
  "include": [
    "unit/**/*.ts",
    "unit/**/*.tsx",
    "utils/matchClockPersistence.ts",
    "components/FreeKickEventButton.tsx",
    "types.ts"
  ]
}
