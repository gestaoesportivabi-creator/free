# API URL
VITE_API_URL=http://localhost:3000/api

# Google Analytics 4 (fluxo Web Scout 21)
VITE_GA4_ID=G-JDLX263HXT

# Google Ads (opcional — IDs públicos no cliente)
# Conta Ads: AW-XXXXXXXXX
# VITE_GOOGLE_ADS_ID=AW-XXXXXXXXX
# Conversão de cadastro: AW-XXXXXXXXX/YYYYYYYYYYY
# VITE_GOOGLE_ADS_CONVERSION_ID=AW-XXXXXXXXX/YYYYYYYYYYY

# Google Search Console — meta verification (opcional)
# VITE_GSC_VERIFICATION=

# Stripe NÃO entra no bundle do Vite.
# STRIPE_PUBLISHABLE_KEY, STRIPE_SECRET_KEY e STRIPE_WEBHOOK_SECRET ficam no backend
# (Vercel → Settings → Environment Variables). O checkout hospedado não precisa de VITE_STRIPE_*.
