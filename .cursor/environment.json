{
  "$schema": "https://www.cursor.com/schemas/environment.schema.json",
  "name": "scout21",
  "install": "bash .cursor/install.sh",
  "start": "bash .cursor/start.sh",
  "terminals": [
    {
      "name": "backend",
      "command": "npm run dev:backend",
      "description": "Express API (backend/) on PORT 3000 — usa Postgres local (localhost:5432) por padrão; se DATABASE_URL vier de Secret, usa o banco externo"
    },
    {
      "name": "frontend",
      "command": "npm run dev:frontend",
      "description": "Vite React (21Scoutpro/) on http://localhost:5173"
    }
  ],
  "ports": [
    { "name": "api", "port": 3000 },
    { "name": "web", "port": 5173 }
  ]
}
